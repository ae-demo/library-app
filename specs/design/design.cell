title library-app

component library-webapp as "Library Web App" web-application
component library-api as "Library API" service
component library-agent as "Library Agent" ai-agent
component library-db as "Library Database" database
component library-agent-memory-db as "Library Agent Memory" database

east user-auth as "Thunder Auth" identity-server

north -> library-webapp
north -> library-api
north -> library-agent

library-webapp -> library-api
library-webapp -> library-agent
library-webapp -> user-auth

library-api -> user-auth
library-api -> library-db

library-agent -> library-api
library-agent -> user-auth
library-agent -> library-agent-memory-db
